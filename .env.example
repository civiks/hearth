# Database
DATABASE_URL=postgresql+psycopg://household:household@localhost:5432/household

# Redis (used by Celery broker/result, slowapi rate-limit storage)
REDIS_URL=redis://localhost:6379

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-too
JWT_LIFETIME_SECONDS=3600

# SMTP (MailHog locally; Resend or similar in prod)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@household-services.local

# CORS — comma-separated origins the FastAPI backend should allow
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

# App
ENV=local
DEBUG=true
