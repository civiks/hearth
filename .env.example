# Database
DATABASE_URL=postgresql+psycopg://household:household@localhost:5432/household
# Local-only fallback if you don't want to run Postgres + Redis:
# DATABASE_URL=sqlite:///./hearth.db
# CELERY_EAGER=true

# Gemini API key
# There are two ways to give the agent a Gemini API key. You only need one.
#
# (1) Server-wide fallback — used for every user who hasn't pasted their own
#     key. Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
#
# (2) BYOK (recommended for multi-user) — users paste their key in
#     Settings → AI and the server encrypts it per-user with this Fernet key.
#     Generate with:
#       python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GEMINI_KEY_ENCRYPTION_KEY=
#
# Default model the agent picks when the user hasn't chosen one. Override
# only if you want Pro by default; Flash is plenty for the tool-calling loop.
# GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Redis (used by Celery broker/result, slowapi rate-limit storage)
REDIS_URL=redis://localhost:6379

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-in-production
JWT_SECRET=change-in-production
JWT_LIFETIME_SECONDS=3600

# SMTP (MailHog locally; Resend or similar in prod)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@hearth.local

# CORS — comma-separated origins the FastAPI backend should allow
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

# App
ENV=local
DEBUG=true
